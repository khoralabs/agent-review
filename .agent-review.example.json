{
  "model": {
    "review": "google/gemini-3.5-flash",
    "analyze": "google/gemini-3.5-flash",
    "commitMessage": "google/gemini-3.5-flash-lite"
  },
  "skillsDirs": [".agents/skills"],
  "instructions": [],
  "blockOn": ["error"],
  "maxDiffBytes": 200000,
  "defaultScope": "staged",
  "outputDir": ".data/agent-review",
  "analystConcurrency": 4,
  "includeWorkstream": false,
  "workstreams": {
    "autoCommit": false,
    "autoLink": true,
    "autoBranch": false
  },
  "agent": {
    "backend": "llm"
  },
  "llm": {
    "provider": "gateway"
  },
  "health": {
    "defaultScope": "src",
    "scopes": {
      "src": {
        "path": "src",
        "excludeDirNames": ["node_modules", ".git", "dist", ".data"]
      }
    },
    "cognitiveHotspotThreshold": 15,
    "cyclomaticHotspotThreshold": 15,
    "topN": 20,
    "alwaysRunLizard": false
  },
  "skip": false
}
